# =====================================================================
# 재생E AI Agent — Git Ignore 설정
# =====================================================================

# 의존성 패키지 디렉토리 배제 (가장 중요)
node_modules/
jspm_packages/
web_modules/

# 로컬 DB 및 미디어 파일 저장 볼륨 배제
/db/
/backend/media/
db.sqlite3

# 원본 공간데이터 배제 — 용량이 크고 배포처에서 재수급 가능
#   heritage : 국가유산청 https://www.khs.go.kr 공간정보 다운로드
#   forest   : 산림공간정보서비스 https://map.forest.go.kr 산림공간자료 다운로드
#   ecoapi   : 국립생태원 생태자연도 API 프로브 산출물
#   dem      : 국토지리정보원 공개DEM(*.zip은 아래 전역 규칙에 이미 걸림)·
#              Copernicus GLO-30 원본 — 받는 법은 backend/data/dem/README.md
#   solar    : 기상청 태양기상자원지도 netCDF(연평균, 재수급 가능) ·
#              쓰지 않는 원본 확인용 프로브 덤프(_permits_raw.json, 코드
#              어디서도 참조하지 않음) — 받는 법은 backend/data/solar/README.md
# (vworld 프로브 결과·korec 판독 엑셀은 시드 근거라 예외적으로 추적한다)
/backend/data/heritage/
/backend/data/forest/
/backend/data/ecoapi/
/backend/data/dem/ngii_90m/
/backend/data/dem/ngii_5m/
/backend/data/dem/copernicus/
/backend/data/solar/kma_resource_map/
/backend/data/solar/gsa/
/backend/data/solar/_permits_raw.json

# 파이썬 캐시 및 가상환경 배제
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# 환경 변수 파일 배제 (보안 비밀)
.env
.env*.local

# 로그 및 임시 파일 배제
*.log
.DS_Store
Thumbs.db

# API Key 및 자격증명 텍스트 파일 배제 (보안 배제 정책)
*api key*.txt
*API KEY*.txt
*.txt
# 단, 의존성 목록은 이미지 빌드에 필수다 (*.txt 일괄 배제에 걸려 누락돼 있었음)
!backend/requirements.txt

# IDE 및 도구 임시 설정 배제
.gemini/
.agents/
.idea/
.vscode/

# 스크래치/생성물 배제 (계약 초안 등 실명 산출물이 커밋되지 않도록)
/backend/scratch/

# 데이터 백업 번들 배제 (media+.env 기밀 포함, 저장소에 올리지 않음)
*.tar
*.zip
260618_backup/

# 전기위원회 원본 첨부 배제 — 공개 자료이나 용량이 크고(회차마다 수백KB)
# sync_korec 으로 언제든 다시 받는다. 판독 결과인 엑셀은 남긴다.
/backend/data/korec/pdf/
