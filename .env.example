# =====================================================================
# 재생에너지 입지타당성 검토 시스템 — 환경변수 템플릿 (.env.example)
# ---------------------------------------------------------------------
# 사용법: 이 파일을 복사해 `.env`로 만든 뒤 실제 값을 채우십시오.
#   (PowerShell) Copy-Item .env.example .env
# 주의: 실제 `.env`는 .gitignore로 제외되며 GitHub에 올라가지 않습니다.
#       비밀 키(DJANGO_SECRET·각 공공 API 키)는 별도 안전 채널로 전달하십시오.
# =====================================================================

# --- PostgreSQL (docker-compose가 이 값으로 DB를 초기화) ---
POSTGRES_DB=re_agent
POSTGRES_USER=re_user
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Django ---
DJANGO_SECRET_KEY=__CHANGE_ME_random_50+_chars__
DJANGO_DEBUG=True

# --- 인프라 (컨테이너 내부 네트워크 기준 기본값) ---
# Redis는 외부 공간정보 API 응답 캐시다. 없으면 프로세스 로컬 캐시로 내려가고,
# 같은 지점을 다시 볼 때마다 외부 API를 다시 호출해 사용량 제한에 걸린다.
REDIS_URL=redis://redis:6379/0

# --- 프론트엔드 ---
VITE_API_BASE=http://localhost:8000/api

# --- 풍력 입지·인허가 검토 (windsite) ---
# 비워두면 해당 항목은 UNKNOWN(확인 필요)으로 표시됩니다. 발급 방법은 docs/WINDSITE_API_KEYS.md 참고.
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
# 공공데이터포털 일반 인증키 — 반드시 "Decoding" 값을 넣으십시오.
# Encoding 값을 넣으면 클라이언트가 다시 인코딩해 인증 오류가 납니다.
DATA_GO_KR_KEY=
# 생태자연도(국립생태원 B553084). 비우면 위 DATA_GO_KR_KEY를 그대로 사용합니다.
ECO_API_KEY=
ECO_API_BASE=https://apis.data.go.kr/B553084/ecoapi/EcologyzmpService
EGIS_API_KEY=
EGIS_ECOMAP_URL=
EGIS_PROTECTED_URL=
# 산사태위험지도 — 생활안전지도(safemap.go.kr) 오픈API. 제공기관은 산림청이지만
# **공공데이터포털과 별개 포털이라 인증키도 별도**입니다.
#   발급: https://safemap.go.kr → 오픈API → 오픈API 인증키 발급
#   ※ 데이터 포맷이 WMS(지도 이미지)라 등급값을 직접 주지 않습니다.
#     GetFeatureInfo 또는 GetMap 픽셀 색상 역변환으로 등급을 얻습니다.
FOREST_API_KEY=
FOREST_LANDSLIDE_URL=https://safemap.go.kr/openapi2/IF_0046_WMS
# 국가유산은 3단계부터 SHP 직접 적재(load_spatial_shp)로 처리하므로 아래 키는 선택입니다.
HERITAGE_API_KEY=
HERITAGE_URL=
# 기상청 ASOS (공공데이터포털) — 비우면 DATA_GO_KR_KEY를 그대로 사용합니다.
KMA_API_KEY=

# 기상청 API허브 — 관측지점 목록(위경도·표고) 조회용.
# ⚠️ 공공데이터포털과 **별개 사이트**라 인증키도 다릅니다.
#   발급: https://apihub.kma.go.kr → 회원가입 → 로그인 → 마이페이지 → 인증키
#   확인: python scripts/kma_station_probe.py
KMA_APIHUB_KEY=

# 국가법령정보 공동활용 OPEN API (법제처) — 법령·조례 원문 자동 대조.
# 값은 신청 이메일의 ID(@ 앞부분)입니다. 비우면 공용 데모 계정 'test'로 동작하지만
# 사용량 제한이 있으니 https://open.law.go.kr 에서 직접 발급받아 넣으십시오.
LAW_API_OC=

# OpenStreetMap Overpass — 변전소·송전선로·정온시설 탐색 (인증키 불필요).
# 공개 인스턴스는 사용량 제한(429)이 잦습니다. 쉼표로 대체 인스턴스를 함께 지정할 수 있습니다.
OVERPASS_URL=https://overpass-api.de/api/interpreter
