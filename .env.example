# =====================================================================
# 재생E AI Agent — 환경변수 템플릿 (.env.example)
# ---------------------------------------------------------------------
# 사용법: 이 파일을 복사해 `.env`로 만든 뒤 실제 값을 채우십시오.
#   (PowerShell) Copy-Item .env.example .env
# 주의: 실제 `.env`는 .gitignore로 제외되며 GitHub에 올라가지 않습니다.
#       비밀 키(LLM/EMBEDDING/TAVILY/DJANGO_SECRET)는 별도 안전 채널로 전달하십시오.
# =====================================================================

# --- PostgreSQL (docker-compose가 이 값으로 DB를 초기화) ---
POSTGRES_DB=re_agent
POSTGRES_USER=re_user
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Django ---
DJANGO_SECRET_KEY=__CHANGE_ME_random_50+_chars__
DJANGO_DEBUG=True

# --- LLM (OpenAI 호환 엔드포인트) ---
# 예) https://api.openai.com/v1  또는  https://openrouter.ai/api/v1
LLM_API_BASE=__LLM_API_BASE__
LLM_API_KEY=__CHANGE_ME__
LLM_MODEL=gpt-4o

# --- 임베딩 (BGE-M3) ---
# EMBEDDING_DEVICE: api | cpu | cuda  (api면 아래 BASE/KEY 필요)
EMBEDDING_API_BASE=__EMBEDDING_API_BASE__
EMBEDDING_API_KEY=__CHANGE_ME__
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=api

# --- 인프라 (컨테이너 내부 네트워크 기준 기본값) ---
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# --- 프론트엔드 ---
VITE_API_BASE=http://localhost:8000/api

# --- 외부 웹 검색 (Tavily Tool Calling) ---
TAVILY_API_KEY=__CHANGE_ME__

# --- 풍력 입지·인허가 검토 (windsite) ---
# 비워두면 해당 항목은 UNKNOWN(확인 필요)으로 표시됩니다. 발급 방법은 docs/WINDSITE_API_KEYS.md 참고.
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
DATA_GO_KR_KEY=
EGIS_API_KEY=
EGIS_ECOMAP_URL=
EGIS_PROTECTED_URL=
FOREST_API_KEY=
FOREST_LANDSLIDE_URL=
# 국가유산은 3단계부터 SHP 직접 적재(load_spatial_shp)로 처리하므로 아래 키는 선택입니다.
HERITAGE_API_KEY=
HERITAGE_URL=
KMA_API_KEY=

# 국가법령정보 공동활용 OPEN API (법제처) — 법령·조례 원문 자동 대조.
# 값은 신청 이메일의 ID(@ 앞부분)입니다. 비우면 공용 데모 계정 'test'로 동작하지만
# 사용량 제한이 있으니 https://open.law.go.kr 에서 직접 발급받아 넣으십시오.
LAW_API_OC=

# OpenStreetMap Overpass — 변전소·송전선로·정온시설 탐색 (인증키 불필요).
# 공개 인스턴스는 사용량 제한(429)이 잦습니다. 쉼표로 대체 인스턴스를 함께 지정할 수 있습니다.
OVERPASS_URL=https://overpass-api.de/api/interpreter
